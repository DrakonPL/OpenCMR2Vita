// Direct3D 7 texture stages, alpha test, fog and the distance fade: a port of
// ../fixed.frag for one fragment key. tools/gen_gxm_shaders.py writes one
// variant per key into gxp/, with these defines and the samplers in front:
//   STAGEn_OP, STAGEn_ALPHA_OP: the stage's operations (GFX_TOP_*; DISABLE: off)
//   STAGEn_KIND: 0 none, 1 2D, 2 cube, 3 bump, 4 distance field, 5 menu dot, 6 vector icon
//   STAGEn_SCALED: a point-filtered 2D texture read through a linear sampler
//   ALPHA_TEST: 0 off, 1 discard (blending off), 2 colour and alpha 0 (blending on)
//   ALPHA_COMPARE: 1 alpha >= threshold, 2 alpha < threshold, 3 the general compare
//   FOG, FOG_TABLE, SPECULAR_ADD, FADE: 0 or 1
//   STAGEn_COLOR1, STAGEn_COLOR2, STAGEn_ALPHA1, STAGEn_ALPHA2: the stage's
//     arguments, as expressions over diffuse, specular, current and texel. A
//     variant made for one arguments key (render/shader_key.h) has them and
//     ALPHA_COMPARE fixed. The general variant reads them from fu[] with Arg()
//     and Compare().
// Samplers: tex0, cube0, native0, tex1, cube1, native1, backdrop, as used.

#include "uniforms.h"

#define TOP_DISABLE 1
#define TOP_SELECTARG1 2
#define TOP_SELECTARG2 3
#define TOP_MODULATE 4
#define TOP_MODULATE2X 5
#define TOP_MODULATE4X 6
#define TOP_ADD 7
#define TOP_ADDSIGNED 8
#define TOP_ADDSIGNED2X 9
#define TOP_SUBTRACT 10
#define TOP_BUMPENVMAP 22
#define TOP_BUMPENVMAPLUMINANCE 23

uniform float4 fu[FU_ROWS];

// source: 0 diffuse, 1 current, 2 texture, 3 texture factor, 4 specular.
float4 Arg(float source, float complement, float replicate, float4 diffuse, float4 specular, float4 current,
           float4 texel)
{
    float4 v = current;
    if (source < 0.5)
        v = diffuse;
    else if (source > 1.5 && source < 2.5)
        v = texel;
    else if (source > 2.5 && source < 3.5)
        v = fu[FU_TEXTURE_FACTOR];
    else if (source > 3.5)
        v = specular;
    if (complement > 0.5)
        v = 1.0 - v;
    if (replicate > 0.5)
        v = v.aaaa;
    return v;
}

// op is a constant of the variant: the compiler keeps one branch.
float4 Op(const int op, float4 a, float4 b)
{
    if (op == TOP_SELECTARG1)
        return a;
    if (op == TOP_SELECTARG2)
        return b;
    if (op == TOP_MODULATE)
        return a * b;
    if (op == TOP_MODULATE2X)
        return saturate(a * b * 2.0);
    if (op == TOP_MODULATE4X)
        return saturate(a * b * 4.0);
    if (op == TOP_ADD)
        return saturate(a + b);
    if (op == TOP_ADDSIGNED)
        return saturate(a + b - 0.5);
    if (op == TOP_ADDSIGNED2X)
        return saturate((a + b - 0.5) * 2.0);
    if (op == TOP_SUBTRACT)
        return saturate(a - b);
    return a;
}

// Texture stage 0 and 1 on current. The names diffuse, specular, current and
// texel are what the STAGEn_ argument expressions read.
float4 Stage0(float4 diffuse, float4 specular, float4 current, float4 texel)
{
    float4 color = Op(STAGE0_OP, STAGE0_COLOR1, STAGE0_COLOR2);
    float alpha = current.a;
#if STAGE0_ALPHA_OP != TOP_DISABLE
    alpha = Op(STAGE0_ALPHA_OP, STAGE0_ALPHA1, STAGE0_ALPHA2).a;
#endif
    return float4(color.rgb, alpha);
}

float4 Stage1(float4 diffuse, float4 specular, float4 current, float4 texel)
{
    float4 color = Op(STAGE1_OP, STAGE1_COLOR1, STAGE1_COLOR2);
    float alpha = current.a;
#if STAGE1_ALPHA_OP != TOP_DISABLE
    alpha = Op(STAGE1_ALPHA_OP, STAGE1_ALPHA1, STAGE1_ALPHA2).a;
#endif
    return float4(color.rgb, alpha);
}

// A point-filtered texture through a linear sampler: filtered smoothly where
// it is scaled, the nearest texel, as the point filter reads it, where it
// keeps its size.
float4 SampleScaledPoint(sampler2D t2, float2 size, float2 uv)
{
    float2 t = uv * size;
    float2 d = fwidth(t);
    float2 nearest = floor(t) + 0.5;
    t = float2(abs(d.x - 1.0) > 0.01 ? t.x : nearest.x, abs(d.y - 1.0) > 0.01 ? t.y : nearest.y);
    return tex2Dlod(t2, float4(t / size, 0.0, 0.0));
}

// A distance field in alpha (0.5 on the edge): its coverage of the pixel,
// with an edge one pixel wide at any scale.
float4 SampleDistanceField(sampler2D t2, float2 uv)
{
    float4 t = tex2D(t2, uv);
    float w = max(fwidth(t.a), 1e-5);
    return float4(t.rgb, saturate((t.a - 0.5) / w + 0.5));
}

// The large matrix sprite is a white circle in a padded cell: 11 pixels
// across in the 16x16 set, 18 in the 32x32 set. Keep its original coverage
// at native size and below; enlarged, evaluate its edge at screen resolution.
float4 SampleMenuDot(sampler2D t2, float2 size, float2 uv)
{
    float2 p = uv * size;
    if (all(fwidth(p) >= 0.999))
        return SampleScaledPoint(t2, size, uv);
    float radius = size.x < 24.0 ? 5.5 : 9.0;
    float edge = length(p - radius) - radius;
    float coverage = saturate(0.5 - edge / max(fwidth(edge), 1e-5));
    return float4(1.0, 1.0, 1.0, coverage);
}

float IconCoverage(float edge)
{
    return saturate((edge - 0.5) / max(fwidth(edge), 1e-5) + 0.5);
}

// sizes: the field's width and height, the original's width and height.
float4 SampleVectorIcon(sampler2D field, sampler2D original, float4 sizes, float2 uv, const int scaledPoint)
{
    // The original image remains bound, including its compressed format.
    // Native-size and smaller draws therefore preserve the original pixels.
    float2 pixels = uv * sizes.zw;
    if (all(fwidth(pixels) >= 0.999))
        return scaledPoint != 0 ? SampleScaledPoint(original, sizes.zw, uv) : tex2D(original, uv);
    // Keep the field's filter footprint inside its band. Padded matrix
    // points touch the texture edges; sampling a palette band there would
    // turn transparent padding into thin lines across adjacent map cells.
    float2 halfTexel = 0.5 / sizes.xy;
    float2 fieldUV = clamp(uv * float2(1.0, 1.0 / 3.0), halfTexel, float2(1.0, 1.0 / 3.0) - halfTexel);
    float4 distances = tex2Dlod(field, float4(fieldUV, 0.0, 0.0));
    float3 colour = tex2Dlod(field, float4(fieldUV + float2(0.0, 1.0 / 3.0), 0.0, 0.0)).rgb;
    float3 detail = tex2Dlod(field, float4(fieldUV + float2(0.0, 2.0 / 3.0), 0.0, 0.0)).rgb;
    float ink = distances.r > 0.5 ? IconCoverage(distances.g) : 1.0;
    return float4(lerp(detail, colour, ink), IconCoverage(distances.b));
}

#if STAGE0_KIND == 0
#define SAMPLE0(coord) float4(1.0, 1.0, 1.0, 1.0)
#elif STAGE0_KIND == 2
#define SAMPLE0(coord) texCUBE(cube0, (coord).xyz)
#elif STAGE0_KIND == 4
#define SAMPLE0(coord) SampleDistanceField(tex0, (coord).xy)
#elif STAGE0_KIND == 5
#define SAMPLE0(coord) SampleMenuDot(tex0, fu[FU_TEX_SIZE0].xy, (coord).xy)
#elif STAGE0_KIND == 6
#define SAMPLE0(coord) SampleVectorIcon(tex0, native0, fu[FU_TEX_SIZE0], (coord).xy, STAGE0_SCALED)
#elif STAGE0_SCALED
#define SAMPLE0(coord) SampleScaledPoint(tex0, fu[FU_TEX_SIZE0].xy, (coord).xy)
#else
#define SAMPLE0(coord) tex2D(tex0, (coord).xy)
#endif

#if STAGE1_KIND == 0
#define SAMPLE1(coord) float4(1.0, 1.0, 1.0, 1.0)
#elif STAGE1_KIND == 2
#define SAMPLE1(coord) texCUBE(cube1, (coord).xyz)
#elif STAGE1_KIND == 4
#define SAMPLE1(coord) SampleDistanceField(tex1, (coord).xy)
#elif STAGE1_KIND == 5
#define SAMPLE1(coord) SampleMenuDot(tex1, fu[FU_TEX_SIZE1].xy, (coord).xy)
#elif STAGE1_KIND == 6
#define SAMPLE1(coord) SampleVectorIcon(tex1, native1, fu[FU_TEX_SIZE1], (coord).xy, STAGE1_SCALED)
#elif STAGE1_SCALED
#define SAMPLE1(coord) SampleScaledPoint(tex1, fu[FU_TEX_SIZE1].xy, (coord).xy)
#else
#define SAMPLE1(coord) tex2D(tex1, (coord).xy)
#endif

float SignedByte(float v)
{
    float b = floor(v * 255.0 + 0.5);
    return (b >= 128.0 ? b - 256.0 : b) / 128.0;
}

// func: GFX_CMP_* (1 never, 2 less, 3 equal, 4 less or equal, 5 greater,
// 6 not equal, 7 greater or equal, else always); a, b: whole numbers.
bool Compare(float func, float a, float b)
{
    if (func < 0.5 || func > 7.5)
        return true;
    if (func < 1.5)
        return false;
    if (func < 2.5)
        return a < b;
    if (func < 3.5)
        return a == b;
    if (func < 4.5)
        return a <= b;
    if (func < 5.5)
        return a > b;
    if (func < 6.5)
        return a != b;
    return a >= b;
}

float4 main(
    float4 vDiffuse : TEXCOORD0,
    float4 vSpecular : TEXCOORD1,
    float4 vTex0 : TEXCOORD2,
    float4 vTex1 : TEXCOORD3,
    float4 vEye : TEXCOORD4,    // eye position (its z the eye depth); w: fog
    float4 wpos : WPOS) : COLOR
{
    float4 current = vDiffuse;
    float2 bumpOffset = float2(0.0, 0.0);
    float luminance = 1.0;

#if STAGE0_OP != TOP_DISABLE
#if STAGE0_OP == TOP_BUMPENVMAP || STAGE0_OP == TOP_BUMPENVMAPLUMINANCE
    {
        float4 bump = tex2D(tex0, vTex0.xy);
        float du = SignedByte(bump.r), dv = SignedByte(bump.g);
        const float4 m = fu[FU_BUMP_MATRIX];
        bumpOffset = float2(du * m.x + dv * m.z, du * m.y + dv * m.w);
#if STAGE0_OP == TOP_BUMPENVMAPLUMINANCE
        luminance = saturate(bump.b * fu[FU_BUMP_LUMINANCE].x + fu[FU_BUMP_LUMINANCE].y);
#endif
    }
#else
    current = Stage0(vDiffuse, vSpecular, current, SAMPLE0(vTex0));
#endif
#if STAGE1_OP != TOP_DISABLE
    {
        float4 texel = SAMPLE1(vTex1 + float4(bumpOffset, 0.0, 0.0));
        texel.rgb *= luminance;
        current = Stage1(vDiffuse, vSpecular, current, texel);
    }
#endif
#endif

#if SPECULAR_ADD
    current.rgb = saturate(current.rgb + vSpecular.rgb);
#endif

#if ALPHA_TEST != 0
    const float4 alphaTest = fu[FU_ALPHA_TEST];
#if ALPHA_COMPARE == 1
    const bool passed = current.a >= alphaTest.z;
#elif ALPHA_COMPARE == 2
    const bool passed = current.a < alphaTest.z;
#else
    const bool passed = Compare(alphaTest.x, floor(current.a * 255.0 + 0.5), alphaTest.y);
#endif
#if ALPHA_TEST == 1
    if (!passed)
        discard;
#endif
#endif

#if FOG
    {
        float f = vEye.w;
#if FOG_TABLE
        const float4 fogParams = fu[FU_FOG_PARAMS];
        float range = fogParams.y - fogParams.x;
        f = range != 0.0 ? saturate((fogParams.y - vEye.z) / range) : 1.0;
#endif
        current.rgb = lerp(fu[FU_FOG_COLOR].rgb, current.rgb, f);
    }
#endif

    // Toward the far plane the scenery dissolves into the sky and backdrop
    // behind it, the back buffer's pixel as it was before the scenery. By the
    // distance from the eye, not the depth along the view, so that a point
    // fades the same however the view turns.
#if FADE
    {
        const float4 fade = fu[FU_DISTANCE_FADE];
        float f = smoothstep(fade.x, fade.y, length(vEye.xyz));
        float3 behind = tex2D(backdrop, (floor(wpos.xy) + 0.5) * fu[FU_TARGET].xy).rgb;
        current.rgb = lerp(current.rgb, behind, f);
    }
#endif

#if ALPHA_TEST == 2
    // A failed test adds nothing under the blend modes the generator allows.
    if (!passed)
        current = float4(0.0, 0.0, 0.0, 0.0);
#endif
    return current;
}
