// A quad that covers the viewport exactly, at the clear depth, from the
// vertex index alone (a strip of indices 0, 1, 2, 3). Exact: the region clip
// of GXM is coarse, so a clear of part of the target must not reach past it.
// The backdrop copy draws with it too.

float4 main(unsigned int aIndex : INDEX, uniform float4 clearDepth) : POSITION
{
    float x = (aIndex == 1 || aIndex == 3) ? 1.0 : -1.0;
    float y = aIndex >= 2 ? 1.0 : -1.0;
    return float4(x, y, clearDepth.x, 1.0);
}
